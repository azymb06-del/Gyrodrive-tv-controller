<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:padding="12dp">

    <!-- ========================================== -->
    <!-- TOP BAR CONTROLS                           -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Scan & Connect TV Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanConnect"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Scan &amp; Connect TV"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00E5FF"
            app:backgroundTint="#1A00E5FF"
            app:cornerRadius="12dp" />

        <!-- Calibrate Center Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalibrateCenter"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Calibrate Center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            app:strokeColor="#334155"
            app:cornerRadius="12dp" />

        <!-- Handbrake (X) Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHandbrake"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Handbrake (X)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FF9100"
            app:backgroundTint="#26FF9100"
            app:cornerRadius="12dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Sensitivity Lock Angle Slider / Control -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvLockLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lock: 900° (±450°)"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderLockAngle"
                android:layout_width="160dp"
                android:layout_height="32dp"
                android:valueFrom="0.0"
                android:valueTo="2.0"
                android:stepSize="1.0"
                android:value="2.0"
                app:thumbColor="#00E5FF"
                app:trackColorActive="#00E5FF"
                app:trackColorInactive="#334155"
                app:haloColor="#1A00E5FF" />
        </LinearLayout>

        <!-- Connection Status Indicator Pill -->
        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Status: Disconnected"
            android:textColor="#EF4444"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ========================================== -->
    <!-- LEFT TOUCH AREA: BRAKE PEDAL               -->
    <!-- ========================================== -->
    <FrameLayout
        android:id="@+id/brakeTouchContainer"
        android:layout_width="150dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnBrakePedal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvBrakeSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛑"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvBrakeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="BRAKE"
                android:textColor="#FF1744"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="BTN 2 / B"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

    <!-- ========================================== -->
    <!-- RIGHT TOUCH AREA: THROTTLE PEDAL           -->
    <!-- ========================================== -->
    <FrameLayout
        android:id="@+id/throttleTouchContainer"
        android:layout_width="150dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnThrottlePedal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvThrottleSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvThrottleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="THROTTLE"
                android:textColor="#00E676"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="BTN 1 / A"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

    <!-- ========================================== -->
    <!-- CENTER COCKPIT & DIGITAL TELEMETRY         -->
    <!-- ========================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centerCockpit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:padding="12dp"
        app:layout_constraintStart_toEndOf="@id/brakeTouchContainer"
        app:layout_constraintEnd_toStartOf="@id/throttleTouchContainer"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Center Wheel Graphic (Rotates with Gyro) -->
        <ImageView
            android:id="@+id/ivSteeringWheel"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="Steering Wheel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Telemetry Details Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/ivSteeringWheel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEERING ANGLE"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Large Digital Angle Readout -->
            <TextView
                android:id="@+id/tvAngleReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0°"
                android:textColor="#00E5FF"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" />

            <!-- Horizontal Steering Progress Indicator -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/steeringProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="1000"
                android:progress="500"
                app:indicatorColor="#00E5FF"
                app:trackColor="#334155"
                app:trackCornerRadius="4dp" />

            <!-- Detailed Telemetry Status -->
            <TextView
                android:id="@+id/tvTelemetryDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stick X: 0 | Lock: ±450° | HID: Ready"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
